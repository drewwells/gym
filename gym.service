[Unit]
Description=Gym Class Calendar (multi-gym)
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
WorkingDirectory=%h/src/github.com/drewwells/gym
ExecStart=/home/drew/.local/bin/podman-compose up --build
ExecStop=/home/drew/.local/bin/podman-compose down
TimeoutStopSec=30

[Install]
WantedBy=default.target
